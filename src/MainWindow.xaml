<Window x:Class="CleaN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CleaN.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="cleaN" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: brand mark, preview switch and the light/dark toggle. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{DynamicResource Brush.LogoBackground}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Path Data="{StaticResource Geometry.Logo}" Stretch="Uniform" Margin="7"
                              Fill="{DynamicResource Brush.LogoForeground}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="cleaN" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Text.Muted}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Preview mode" IsChecked="{Binding PreviewOnly, Mode=TwoWay}"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Save log files" IsChecked="{Binding WriteLog, Mode=TwoWay}" Margin="0,0,16,0" />
                    <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource Button.Icon}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown only when cleaN was started without administrator rights. -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.WarningSoft}" Padding="20,10"
                Visibility="{Binding ShowElevationWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ElevationWarning}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Brush.Warning}" />
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Brush.DangerSoft}" Padding="20,10"
                Visibility="{Binding PreviewOnly, Converter={StaticResource NotBoolToVisibility}}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Danger}"
                       Text="Preview mode is off. Anything you clean from now on is deleted permanently." />
        </Border>

        <TabControl Grid.Row="3" Style="{StaticResource Nav.TabControl}"
                    ItemContainerStyle="{StaticResource Nav.Tab}">

            <TabItem Header="Temporary files">
                <views:CleanupView DataContext="{Binding SystemJunk}" />
            </TabItem>

            <TabItem Header="Browser cache">
                <views:CleanupView DataContext="{Binding BrowserData}" />
            </TabItem>

            <TabItem Header="Empty folders">
                <views:EmptyFoldersView DataContext="{Binding EmptyFolders}" />
            </TabItem>

            <TabItem Header="Unused applications">
                <views:UnusedAppsView DataContext="{Binding UnusedApps}" />
            </TabItem>

            <TabItem Header="Recycle Bin">
                <views:CleanupView DataContext="{Binding RecycleBin}" />
            </TabItem>

            <TabItem Header="Report and logs">
                <views:ReportView DataContext="{Binding Report}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
