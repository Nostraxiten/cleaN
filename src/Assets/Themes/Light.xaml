<!--
    Light theme - the default look: white, minimal, high contrast.
    Dark.xaml defines exactly the same keys, so the two can be swapped at runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#F6F6F7" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FAFAFB" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E2E6" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C9C9CF" />

    <SolidColorBrush x:Key="Brush.Text" Color="#111113" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6C6C75" />
    <SolidColorBrush x:Key="Brush.TextInverse" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#141417" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2E2E34" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#EDEDF0" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#E4E4E9" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBEAE8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#1B6E4B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FDF3E2" />

    <!-- The brand mark stays white with a black N in both themes. -->
    <SolidColorBrush x:Key="Brush.LogoBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.LogoForeground" Color="#000000" />

</ResourceDictionary>
