<!--
    Dark theme - a purpose-built dark palette rather than an inversion of the light one:
    the greys are slightly blue, and the accent flips to light-on-dark so buttons keep
    the same visual weight they have in the light theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Background" Color="#16171A" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#111214" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1D1E22" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#24252B" />
    <SolidColorBrush x:Key="Brush.Border" Color="#31323A" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#44454F" />

    <SolidColorBrush x:Key="Brush.Text" Color="#ECECEF" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#9A9AA5" />
    <SolidColorBrush x:Key="Brush.TextInverse" Color="#16171A" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#F1F1F4" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#D8D8DE" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#16171A" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#26272E" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#2E3038" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F2857B" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A2321" />
    <SolidColorBrush x:Key="Brush.Success" Color="#57C596" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E0AC5C" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#332A18" />

    <SolidColorBrush x:Key="Brush.LogoBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.LogoForeground" Color="#000000" />

</ResourceDictionary>
