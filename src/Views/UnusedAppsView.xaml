<UserControl x:Class="CleaN.Views.UnusedAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid Margin="28,24,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Unused applications" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Subtitle}"
                       Text="Everything installed on this PC, sorted by how long it has gone unused. Launch dates come from Windows Prefetch and from Explorer's own records - no list of known programs is involved. cleaN never uninstalls anything by itself." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unused for" VerticalAlignment="Center" Margin="0,0,10,0"
                               Style="{StaticResource Text.Muted}" />
                    <RadioButton GroupName="Threshold" Style="{StaticResource Radio.Chip}" Content="90 days"
                                 IsChecked="{Binding IsThreshold90, Mode=TwoWay}" />
                    <RadioButton GroupName="Threshold" Style="{StaticResource Radio.Chip}" Content="6 months"
                                 IsChecked="{Binding IsThreshold180, Mode=TwoWay}" />
                    <RadioButton GroupName="Threshold" Style="{StaticResource Radio.Chip}" Content="1 year"
                                 IsChecked="{Binding IsThreshold365, Mode=TwoWay}" />
                    <RadioButton GroupName="Threshold" Style="{StaticResource Radio.Chip}" Content="Show all"
                                 IsChecked="{Binding IsThresholdAll, Mode=TwoWay}" />
                </StackPanel>

                <TextBox Grid.Column="1" Margin="16,0,0,0" MinWidth="180"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Warnings}" Margin="0,0,0,12"
                      Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="6" Padding="12,8"
                            Margin="0,0,0,6">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Brush.Warning}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Top"
                           Text="No applications to show yet. Press Analyze, or widen the filter."
                           Visibility="{Binding HasApplications, Converter={StaticResource NotBoolToVisibility}}" />

                <ListBox ItemsSource="{Binding Applications}"
                         ItemContainerStyle="{StaticResource ListItem.Plain}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasApplications, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text=" - " Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource Text.Muted}"
                                                   FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center"
                                                MinWidth="130">
                                        <TextBlock Text="{Binding UnusedForText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource Text.Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Open folder" Padding="10,5" Margin="0,0,8,0"
                                                Command="{Binding DataContext.OpenLocationCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasInstallLocation,
                                                    Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Uninstall" Padding="10,5"
                                                Style="{StaticResource Button.Danger}"
                                                Command="{Binding DataContext.UninstallCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanUninstall}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="0,14" Margin="0,10,0,0">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Analyze" Command="{Binding AnalyzeCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
