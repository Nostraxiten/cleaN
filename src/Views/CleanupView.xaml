<UserControl x:Class="CleaN.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid Margin="28,24,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectionSummary}" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" Padding="10,5" />
                <Button Content="Clear" Command="{Binding SelectNoneCommand}" Padding="10,5" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <Border Style="{StaticResource Badge}"
                                                Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="needs administrator" Style="{StaticResource Text.Badge}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}"
                                               TextWrapping="Wrap" Margin="27,7,0,0" />

                                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Brush.Warning}" Margin="27,7,0,0"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="16,3,0,0"
                                           VerticalAlignment="Top" Style="{StaticResource Text.Muted}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="0,14" Margin="0,10,0,0">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Text.Mono}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" MaxWidth="270" VerticalAlignment="Center"
                                   Margin="0,0,14,0" TextAlignment="Right" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Analyze" Command="{Binding AnalyzeCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding CleanButtonText}" Command="{Binding CleanCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
