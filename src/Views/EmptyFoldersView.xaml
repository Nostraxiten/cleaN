<UserControl x:Class="CleaN.Views.EmptyFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid Margin="28,24,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Empty folders" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Subtitle}"
                       Text="Folders that contain no files at any depth. System areas, cloud-synced folders and anything behind a junction are skipped, and the list is always shown before a single folder is removed." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Where to look" FontWeight="SemiBold" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding Roots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,0,7" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding CustomRoot, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Add folder" Command="{Binding AddRootCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                           Text="Type a full path to add another location to the scan." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folders found" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" Padding="10,5" />
                        <Button Content="Clear" Command="{Binding SelectNoneCommand}" Padding="10,5" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource Text.Muted}" VerticalAlignment="Top"
                           Text="Nothing scanned yet. Pick the locations above and press Scan."
                           Visibility="{Binding HasResults, Converter={StaticResource NotBoolToVisibility}}" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Found}"
                         ItemContainerStyle="{StaticResource ListItem.Plain}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}"
                                               TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="0,14" Margin="0,10,0,0">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Text.Mono}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" MaxWidth="270" VerticalAlignment="Center"
                                   Margin="0,0,14,0" TextAlignment="Right" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
