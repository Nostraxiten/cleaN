<Application x:Class="CleaN.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CleaN.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the palette and is swapped at runtime by ThemeService. -->
                <ResourceDictionary Source="Assets/Themes/Light.xaml" />
                <ResourceDictionary Source="Assets/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:InverseBooleanToVisibilityConverter x:Key="NotBoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
